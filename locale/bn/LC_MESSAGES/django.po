# Bangla farmer interface for AgriTwin AI.
msgid ""
msgstr "Project-Id-Version: AgriTwin AI 2.0\nLanguage: bn\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

#, python-format
msgid "%(component)s %(change)s"
msgstr "%(component)s: %(change)s"

#, python-format
msgid "%(crop)s: entered pH is outside the profile range %(minimum)s–%(maximum)s."
msgstr "%(crop)s: আপনার দেওয়া pH ফসলটির জন্য ধরা %(minimum)s–%(maximum)s সীমার বাইরে।"

#, python-format
msgid "%(crop)s: entered soil texture is outside this prototype profile's preferred soils; verify drainage and suitability locally."
msgstr "%(crop)s: আপনার দেওয়া মাটির ধরন এই প্রাথমিক মডেলে ফসলটির জন্য পছন্দের মাটির তালিকায় নেই। পানি নিষ্কাশন ও চাষের উপযোগিতা স্থানীয়ভাবে যাচাই করুন।"

#, python-format
msgid "%(day)s %(month)s"
msgstr "%(day)s %(month)s"

#, python-format
msgid "%(delta)s score points: %(explanation)s."
msgstr "স্কোরের পরিবর্তন %(delta)s পয়েন্ট: %(explanation)s।"

#, python-format
msgid "%(strategy)s has the highest eligible relative score under these assumptions."
msgstr "এই শর্তগুলো অনুযায়ী উপযোগী বিকল্পগুলোর মধ্যে ‘%(strategy)s’-এর তুলনামূলক স্কোর সবচেয়ে বেশি।"

#, python-format
msgid "%(years)s-year Meteorological and Solar Monthly & Annual Climatologies (%(start_month)s %(start_year)s - %(end_month)s %(end_year)s)"
msgstr "%(years)s বছরের আবহাওয়া ও সৌর তথ্যের মাসিক ও বার্ষিক গড় (%(start_month)s %(start_year)s – %(end_month)s %(end_year)s)"

