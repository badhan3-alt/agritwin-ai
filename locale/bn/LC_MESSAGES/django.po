msgid "Ask about your crops, soil, water, or farm plan…"
msgstr "আপনার ফসল, মাটি, পানি বা খামারের পরিকল্পনা নিয়ে প্রশ্ন করুন…"

msgid "Use my selected farm information in this chat"
msgstr "এই আলাপে আমার বেছে দেওয়া খামারের তথ্য ব্যবহার করুন"

msgid "Close navigation"
msgstr "নেভিগেশন বন্ধ করুন"

msgid "Saved farm location"
msgstr "সংরক্ষিত খামারের অবস্থান"

msgid "Open in OpenStreetMap"
msgstr "OpenStreetMap-এ দেখুন"

msgid "Map of %(name)s"
msgstr "%(name)s-এর মানচিত্র"

msgid "Zoom in"
msgstr "বড় করুন"

msgid "Zoom out"
msgstr "ছোট করুন"

msgid "Selected farm"
msgstr "নির্বাচিত খামার"

msgid "Select a farm first"
msgstr "আগে একটি খামার বেছে নিন"

msgid "Select farm"
msgstr "খামার নির্বাচন করুন"

msgid "Select a farm to open its climate insights, rotations, scenarios, report, and assistant."
msgstr "জলবায়ু তথ্য, ফসলের পর্যায়ক্রম, পরিস্থিতি পরীক্ষা, প্রতিবেদন ও কৃষি সহকারী খুলতে একটি খামার নির্বাচন করুন।"

msgid "Select the farm you want to use for this option."
msgstr "এই অপশনের জন্য যে খামারটি ব্যবহার করতে চান সেটি নির্বাচন করুন।"

msgid "Bangladesh from space"
msgstr "মহাকাশ থেকে বাংলাদেশ"

msgid "Landsat 9 · 8 February 2022"
msgstr "Landsat 9 · ৮ ফেব্রুয়ারি ২০২২"

msgid "Landsat 9 satellite image of the Bangladesh coast, showing rivers, farmland, and the Sundarbans."
msgstr "Landsat 9-এ তোলা বাংলাদেশের উপকূলের উপগ্রহ ছবিতে নদী, কৃষিজমি ও সুন্দরবন।"

msgid "Image credit:"
msgstr "ছবির সূত্র:"

msgid "Your farms are linked to your account."
msgstr "আপনার খামারগুলো আপনার অ্যাকাউন্টের সাথে যুক্ত হয়েছে।"

msgid "Your account is ready. Sign in on another device to access your farms."
msgstr ""
"আপনার অ্যাকাউন্ট তৈরি হয়েছে। অন্য ডিভাইসে আপনার খামার দেখতে সাইন ইন করুন।"

msgid "You have signed out."
msgstr "আপনি সাইন আউট করেছেন।"

msgid "Your password has been changed."
msgstr "আপনার পাসওয়ার্ড পরিবর্তন হয়েছে।"

msgid "Sign in"
msgstr "সাইন ইন"

msgid "YOUR FARM WORKSPACE"
msgstr "আপনার খামারের কর্মক্ষেত্র"

msgid "Welcome back."
msgstr "আবার স্বাগতম।"

msgid "Sign in to access your farms across devices."
msgstr "বিভিন্ন ডিভাইসে আপনার খামার দেখতে সাইন ইন করুন।"

msgid "Create an account"
msgstr "অ্যাকাউন্ট তৈরি করুন"

msgid ""
"Guest farms saved in this browser will be linked to your account when you "
"sign in."
msgstr ""
"সাইন ইন করলে এই ব্রাউজারে অতিথি হিসেবে সংরক্ষিত খামারগুলো আপনার অ্যাকাউন্টের"
" সাথে যুক্ত হবে।"

msgid "Continue as a guest"
msgstr "অতিথি হিসেবে চালিয়ে যান"

msgid "Take your farms with you."
msgstr "যেখানেই যান, খামার থাকুক সাথে।"

msgid "Create an account to access your saved farms on any device."
msgstr "যেকোনো ডিভাইসে আপনার সংরক্ষিত খামার দেখতে অ্যাকাউন্ট তৈরি করুন।"

msgid ""
"Keep your username and password in a safe place. Guest farms in this browser"
" will be linked to this account."
msgstr ""
"আপনার ব্যবহারকারীর নাম ও পাসওয়ার্ড নিরাপদে রাখুন। এই ব্রাউজারের অতিথি "
"খামারগুলো এই অ্যাকাউন্টে যুক্ত হবে।"

msgid "Already have an account? Sign in"
msgstr "আগেই অ্যাকাউন্ট আছে? সাইন ইন করুন"

msgid "Your account"
msgstr "আপনার অ্যাকাউন্ট"

msgid ""
"Your farms are saved to your account. Sign in with the same username on "
"another device."
msgstr ""
"আপনার খামারগুলো অ্যাকাউন্টে সংরক্ষিত আছে। অন্য ডিভাইসে একই ব্যবহারকারীর নাম "
"দিয়ে সাইন ইন করুন।"

msgid "Saved farms"
msgstr "সংরক্ষিত খামার"

msgid "Change password"
msgstr "পাসওয়ার্ড পরিবর্তন করুন"

msgid "Sign out"
msgstr "সাইন আউট"

msgid "Enter your current password, then choose a new one."
msgstr "বর্তমান পাসওয়ার্ড লিখুন, তারপর নতুন পাসওয়ার্ড বেছে নিন।"

msgid "Enter the same password as before, for verification."
msgstr "নিশ্চিত করার জন্য আগের পাসওয়ার্ডটি আবার লিখুন।"

msgid "Your password can’t be too similar to your other personal information."
msgstr ""
"আপনার পাসওয়ার্ড আপনার অন্যান্য ব্যক্তিগত তথ্যের সাথে বেশি মিলে গেলে চলবে "
"না।"

msgid "Your password can’t be a commonly used password."
msgstr "বহুল ব্যবহৃত কোনো পাসওয়ার্ড বেছে নেওয়া যাবে না।"

msgid "Your password can’t be entirely numeric."
msgstr "পাসওয়ার্ডে শুধু সংখ্যা ব্যবহার করা যাবে না।"

msgid "This password is too common."
msgstr "এই পাসওয়ার্ডটি বহুল ব্যবহৃত।"

msgid "This password is entirely numeric."
msgstr "এই পাসওয়ার্ডটিতে শুধু সংখ্যা রয়েছে।"

msgid "The password is too similar to the %(verbose_name)s."
msgstr "পাসওয়ার্ডটি আপনার %(verbose_name)s-এর সাথে বেশি মিলে যাচ্ছে।"

msgid "The two password fields didn’t match."
msgstr "দুটি পাসওয়ার্ড মেলেনি।"

msgid ""
"Please enter a correct %(username)s and password. Note that both fields may "
"be case-sensitive."
msgstr ""
"সঠিক %(username)s ও পাসওয়ার্ড লিখুন। বড় ও ছোট হাতের অক্ষর আলাদা হিসেবে "
"গণ্য হতে পারে।"

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr ""
"আবশ্যক। সর্বোচ্চ ১৫০ অক্ষর। শুধু বর্ণ, সংখ্যা এবং @/./+/-/_ ব্যবহার করুন।"

msgid ""
"Enter a valid username. This value may contain only letters, numbers, and "
"@/./+/-/_ characters."
msgstr ""
"সঠিক ব্যবহারকারীর নাম লিখুন। শুধু বর্ণ, সংখ্যা এবং @/./+/-/_ ব্যবহার করা "
"যাবে।"

msgid "A user with that username already exists."
msgstr "এই ব্যবহারকারীর নামে ইতোমধ্যে একটি অ্যাকাউন্ট আছে।"

msgid "Enter a GeoJSON Polygon with one closed ring."
msgstr "একটি বন্ধ বলয়সহ GeoJSON Polygon লিখুন।"

msgid "Draw one field boundary without holes."
msgstr "ভেতরে ফাঁক ছাড়া একটি জমির সীমানা আঁকুন।"

msgid "Use between 3 and 500 boundary corners, then close the ring."
msgstr "৩ থেকে ৫০০টি কোণা দিয়ে সীমানা এঁকে বলয়টি বন্ধ করুন।"

msgid "Each corner must contain a finite longitude and latitude."
msgstr "প্রতিটি কোণায় সঠিক দ্রাঘিমাংশ ও অক্ষাংশ থাকতে হবে।"

msgid "Boundary corners must be within the Bangladesh planning area."
msgstr "সীমানার প্রতিটি কোণা বাংলাদেশের পরিকল্পনা এলাকার মধ্যে হতে হবে।"

msgid "Close the boundary by repeating the first corner at the end."
msgstr "শেষে প্রথম কোণাটি আবার দিয়ে সীমানা বন্ধ করুন।"

msgid "Boundary corners must be distinct."
msgstr "সীমানার প্রতিটি কোণা আলাদা হতে হবে।"

msgid "Boundary edges must not cross or touch each other."
msgstr "সীমানার বাহুগুলো একে অপরকে অতিক্রম বা স্পর্শ করতে পারবে না।"

msgid "Boundary area must be between 1 square metre and 100,000 acres."
msgstr "সীমানার আয়তন ১ বর্গমিটার থেকে ১,০০,০০০ একরের মধ্যে হতে হবে।"

msgid "Update farm size from this boundary"
msgstr "এই সীমানা অনুযায়ী খামারের আয়তন হালনাগাদ করুন"

msgid ""
"Replaces the saved farm area with the estimate. Your NASA analysis is "
"unchanged because area is not a scoring input."
msgstr ""
"সংরক্ষিত আয়তনের বদলে আনুমানিক আয়তন ব্যবহার করবে। আয়তন স্কোর গণনায় "
"ব্যবহৃত হয় না, তাই নাসার বিশ্লেষণ বদলাবে না।"

msgid "Boundary coordinates (GeoJSON)"
msgstr "সীমানার স্থানাঙ্ক (GeoJSON)"

msgid ""
"Longitude first, latitude second. Draw on the map or enter a Polygon with "
"one closed ring. Saved area is an estimate, not a land survey."
msgstr ""
"আগে দ্রাঘিমাংশ, পরে অক্ষাংশ। মানচিত্রে আঁকুন বা একটি বন্ধ বলয়ের Polygon "
"লিখুন। সংরক্ষিত আয়তন আনুমানিক, জমি জরিপ নয়।"

msgid "Farm boundary saved. Its area is an estimate, not a land survey."
msgstr "খামারের সীমানা সংরক্ষিত হয়েছে। এর আয়তন আনুমানিক, জমি জরিপ নয়।"

msgid "Boundary removed. Your saved farm size is unchanged."
msgstr "সীমানা মুছে ফেলা হয়েছে। সংরক্ষিত খামারের আয়তন অপরিবর্তিত আছে।"

msgid "Farm boundary"
msgstr "খামারের সীমানা"

msgid "Draw your field."
msgstr "আপনার জমির সীমানা আঁকুন।"

msgid "Mark the corners, save the shape, and estimate its area."
msgstr "কোণাগুলো চিহ্নিত করুন, আকৃতি সংরক্ষণ করুন এবং আয়তন জানুন।"

msgid ""
"Click each corner on the map, then choose Close boundary. Use Undo to remove"
" a corner or Clear to start again."
msgstr ""
"মানচিত্রে প্রতিটি কোণায় ক্লিক করে সীমানা বন্ধ করুন। আগের কোণা সরাতে বা নতুন"
" করে শুরু করতে নিচের বোতাম ব্যবহার করুন।"

msgid ""
"Map unavailable? Enter the GeoJSON coordinates below to save your boundary."
msgstr ""
"মানচিত্র দেখা যাচ্ছে না? সীমানা সংরক্ষণ করতে নিচে GeoJSON স্থানাঙ্ক লিখুন।"

msgid "Close boundary"
msgstr "সীমানা বন্ধ করুন"

msgid "Undo corner"
msgstr "শেষ কোণা সরান"

msgid "Clear drawing"
msgstr "আঁকা মুছুন"

msgid "Corners"
msgstr "কোণা"

msgid "Boundary closed. Save to calculate its area."
msgstr "সীমানা বন্ধ হয়েছে। আয়তন গণনা করতে সংরক্ষণ করুন।"

msgid ""
"Map tiles are unavailable. You can still edit and save coordinates below."
msgstr ""
"মানচিত্রের ছবি পাওয়া যাচ্ছে না। নিচে স্থানাঙ্ক সম্পাদনা ও সংরক্ষণ করতে "
"পারবেন।"

msgid "Coordinate format example"
msgstr "স্থানাঙ্কের বিন্যাসের উদাহরণ"

msgid "Save boundary"
msgstr "সীমানা সংরক্ষণ করুন"

msgid "Saved boundary"
msgstr "সংরক্ষিত সীমানা"

msgid "Estimated area"
msgstr "আনুমানিক আয়তন"

msgid "Perimeter"
msgstr "পরিসীমা"

msgid ""
"WGS84 estimate from your drawn corners. This is not a cadastral map or land "
"survey."
msgstr ""
"আঁকা কোণা থেকে WGS84 অনুযায়ী আনুমানিক হিসাব। এটি মৌজা মানচিত্র বা জমি জরিপ "
"নয়।"

msgid "Download GeoJSON"
msgstr "GeoJSON ডাউনলোড করুন"

msgid "Remove saved boundary"
msgstr "সংরক্ষিত সীমানা মুছুন"

msgid "Saved field boundary, north up"
msgstr "সংরক্ষিত জমির সীমানা, উত্তর ওপরে"

msgid "Boundary schematic · north up · no basemap"
msgstr "সীমানার রেখাচিত্র · উত্তর ওপরে · পটভূমিতে মানচিত্র নেই"

msgid "A second result is needed to compare."
msgstr "তুলনা করতে আরও একটি পরীক্ষার ফল প্রয়োজন।"

msgid "A soil test date cannot be in the future."
msgstr "মাটি পরীক্ষার তারিখ ভবিষ্যতের হতে পারে না।"

msgid "Activity"
msgstr "কাজের ধরন"

msgid ""
"Add a task with a planned date and choose when its reminder should appear."
msgstr "কাজের পরিকল্পিত তারিখ দিন এবং কত দিন আগে স্মরণ করাতে হবে তা বেছে নিন।"

msgid "Add diary entry"
msgstr "ডায়েরিতে লিখুন"

msgid "Add soil test"
msgstr "মাটি পরীক্ষার ফল যোগ করুন"

msgid "Add task"
msgstr "কাজ যোগ করুন"

msgid "Add transaction"
msgstr "লেনদেন যোগ করুন"

msgid "Add your first expense or sale to see your recorded profit or loss."
msgstr "হিসাব অনুযায়ী লাভ বা ক্ষতি দেখতে প্রথম খরচ বা বিক্রির তথ্য যোগ করুন।"

msgid "All planned tasks"
msgstr "পরিকল্পিত সব কাজ"

msgid "Amount (BDT)"
msgstr "পরিমাণ (টাকা)"

msgid "Build a soil test history"
msgstr "মাটি পরীক্ষার ইতিহাস রাখুন"

msgid "Category"
msgstr "বিভাগ"

msgid "Change:"
msgstr "পরিবর্তন:"

msgid "Choose a photo smaller than 5 MB."
msgstr "৫ মেগাবাইটের ছোট একটি ছবি বেছে নিন।"

msgid "Choose either a replacement photo or removal."
msgstr "নতুন ছবি দেওয়া অথবা পুরোনো ছবি মুছে ফেলার মধ্যে একটি বেছে নিন।"

msgid "Completed"
msgstr "সম্পন্ন"

msgid "Crop / field"
msgstr "ফসল / জমি"

msgid "Crop calendar"
msgstr "ফসলের ক্যালেন্ডার"

msgid "Date"
msgstr "তারিখ"

msgid "Delete"
msgstr "মুছে ফেলুন"

msgid "Delete this farm record? This cannot be undone."
