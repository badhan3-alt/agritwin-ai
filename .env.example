# Copy to .env for local overrides. Never commit real deployment secrets.
# Existing process environment variables take precedence.
DJANGO_DEBUG=True
# Run python scripts/setup_env.py to create a private local key.
# In production, set a fresh random key (50+ characters) through the server's secrets manager.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For deployment, list full origins such as https://agritwin.example.com.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional SQLite file path; omit to use the project's default database.
# DJANGO_DATABASE_PATH=C:/path/to/agritwin.sqlite3
# HTTPS redirect and secure cookies are enabled by default when DJANGO_DEBUG=False.
# Do not expose VITE_*, NEXT_PUBLIC_*, or other browser-public variables containing
# service-role keys, admin secrets, private signing keys, or database passwords.
# DJANGO_SECURE_SSL_REDIRECT=True
# HSTS defaults to 3600 seconds in production, 0 during local development.
# DJANGO_SECURE_HSTS_SECONDS=3600

# The farmer chatbot runs locally and needs no API key or AI service.
# Verify with: python manage.py check_chatbot (no network request).
